<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>EDU CLOUD</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Read by Portal.swift. Both come from Config/Portal.xcconfig. -->
	<key>PortalURL</key>
	<string>$(PORTAL_URL)</string>
	<key>PortalHost</key>
	<string>$(PORTAL_HOST)</string>

	<!-- THE SYSTEM SPLASH, ON THE PAGE'S OWN COLOUR.

	     The same trick the Android shell plays: every screen in the launch
	     sequence — this, the in-app loading view, the page — is drawn on the
	     portal's ground colour carrying the same mark, so the eye reads one
	     screen filling in rather than three screens replacing each other.
	     Both names are asset catalog entries with light and dark variants, so
	     a phone in dark mode never sees a white flash. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>PageBackground</string>
		<key>UIImageName</key>
		<string>SplashMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The site draws its own header and follows the phone's dark setting;
	     the bar over it follows the page. -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- THE FILE INPUT, WHICH WKWEBVIEW IMPLEMENTS AND ANDROID DID NOT.

	     Every document a school asks a family for arrives through an
	     <input type="file"> on the portal, and a parent almost always
	     photographs it rather than finds a file. WKWebView offers Photo
	     Library / Take Photo / Choose File on its own, but the Take Photo
	     entry silently vanishes — and the app is killed on the spot if it is
	     reached — unless these two strings are present. The wording is what
	     iOS shows the parent at the moment they are asked. -->
	<key>NSCameraUsageDescription</key>
	<string>To photograph a document the school has asked for, such as a certificate or a bank slip.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To choose a photo or document to send to the school.</string>
	<!-- The app lock: the phone's own face or fingerprint check. Nothing about
	     it reaches the school; see AppLock.swift. -->
	<key>NSFaceIDUsageDescription</key>
	<string>To confirm it is you before showing the school app.</string>

	<!-- KEEPING A RECEIPT WHERE THE PARENT CAN FIND IT NEXT MONTH.

	     Downloads land in this app's Documents folder. These two keys are what
	     make that folder appear in the Files app under "On My iPhone" and let
	     the share sheet reach it, which is the iOS equivalent of Android's
	     public Downloads folder: a receipt saved somewhere no other app can
	     see is a receipt held until the phone changes its mind. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Every request the shell makes is https to the portal; nothing here
	     needs an exception, and none is declared. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
