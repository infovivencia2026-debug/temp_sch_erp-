<resources>
    <!-- The portal's own light palette (web/src/index.css): ground #F7F8FA.
         The shell must match the page it wraps or every load flashes. -->
    <color name="page_bg">#F7F8FA</color>
    <color name="page_text">#000000</color>
    <color name="page_muted">#5F6368</color>
    <!-- The inline banner over a page that is still readable. Dark enough
         that white text on it passes contrast on a phone held in the sun,
         which is where a bus screen is actually read. -->
    <color name="banner_bg">#1F2933</color>
    <color name="banner_text">#FFFFFF</color>
    <!-- The ground the launcher artwork used to carry inside its own bitmap.
         Named separately from page_bg because they answer different questions:
         one is the colour of the page, the other is the colour behind the
         icon, and a school rebranding the portal must not silently restyle
         the home screen. -->
    <color name="launcher_background">#0B0C0E</color>
    <!-- The mark on the in-app loading screen used to be tinted from a
         splash_mark colour here. It is now inked from the luminance of the
         ground actually being drawn (SystemBars.ink), because that ground is
         the page's last reported colour and may not be this theme's. -->
</resources>
