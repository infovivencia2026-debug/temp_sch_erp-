# Cloudflare Pages response headers. The same contract nginx enforces in
# scripts/deploy.sh: hashed assets are immutable for a year, the shell is
# revalidated every time so a deploy reaches every open tab on its next load,
# and the two security headers the site has always sent.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, must-revalidate

# The server-rendered pages' stylesheet and fonts, mirrored from internal/static
# so /login does not wake Cloud Run for three files. Immutable is safe because
# the templates put the file's content hash on the href; the mirror must stay in
# step for that to remain true (see web/public/static/README.md, and `make lint`).
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Map tiles. Fetched dozens at a time by the bus map and never revised in place
# — a re-cut set is a new deployment — so a week, immutable, keeps a warden who
# watches the morning run from re-fetching the same square every pan.
/tiles/*
  Cache-Control: public, max-age=604800, immutable

# The PWA icons and manifest. Not immutable: the manifest is how a change of
# name or theme reaches an installed app, and it must be allowed to expire.
/app/*
  Cache-Control: public, max-age=604800

# The APKs and their pages. A day, because publishing a build replaces the file
# at the same name and a handset should not be a week behind the fix.
/download/*
  Cache-Control: public, max-age=86400

# The sign-in wallpaper: one name, one picture, changed only by a deployment.
/wallpaper.png
  Cache-Control: public, max-age=31536000, immutable

# Fonts, wherever they are served from. The bytes behind a .woff2 name never
# change; a new weight is a new file.
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache, must-revalidate

# The app association files (see web/public/well-known/README.md). Android and
# iOS both refuse anything that is not application/json, and Apple's file has
# no extension for the edge to guess a type from. Both spellings, because the
# rewrite in _redirects leaves the requested (dotted) path as the one matched.
/.well-known/*
  Content-Type: application/json
  Cache-Control: public, max-age=300

/well-known/*
  Content-Type: application/json
  Cache-Control: public, max-age=300

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
