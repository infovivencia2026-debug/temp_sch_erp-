# Local development. Production reads the same variables from
# /etc/school-erp.env via systemd's EnvironmentFile.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8090
BASE_URL=http://localhost:5173

POSTGRES_DB=school_erp
POSTGRES_USER=erp_owner
APP_DB_USER=app_user

# The app connects as the unprivileged role so RLS actually applies.
DATABASE_URL=postgres://app_user:PASSWORD@127.0.0.1:5432/school_erp?sslmode=disable
# Migrations need the owner, which app_user deliberately is not.
MIGRATE_DATABASE_URL=postgres://erp_owner:PASSWORD@127.0.0.1:5432/school_erp?sslmode=disable
DB_MAX_CONNS=10

REDIS_URL=redis://127.0.0.1:6379/0

SESSION_SECRET=
SESSION_TTL=12h
SESSION_IDLE_TTL=2h
PASSWORD_PEPPER=
CREDENTIAL_KEY=

# Unset on purpose: uploads return 503 until these are real, which is exactly
# what the production box is doing today.
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=school-erp
R2_PRESIGN_EXPIRY=10m
