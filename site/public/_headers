# Same contract as web/public/_headers: hashed assets are immutable for a year,
# the shell is revalidated every load so a deploy reaches every open tab, and
# the two security headers the sites have always sent.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
