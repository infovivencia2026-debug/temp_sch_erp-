# Copy to .env and adjust. Nothing here is a secret in development; in staging
# and production every one of these comes from the secret manager, and the app
# refuses to start if a required value is missing rather than falling back to a
# default that happens to point at localhost.

APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# Migrations run as the owner; the application connects as the unprivileged role
# so that row-level security actually applies to it. See scripts/dev-setup.sh.
DATABASE_URL=postgres://schoolerp_app:schoolerp_dev_password@127.0.0.1:5432/schoolerp?sslmode=disable
DB_ADMIN_URL=postgres:///schoolerp?host=/var/run/postgresql
DB_APP_ROLE=schoolerp_app

REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0

SESSION_TTL=12h
CORS_ORIGINS=http://localhost:3000

# Left empty on purpose: Gin trusts X-Forwarded-For from every peer by default,
# which would let a caller choose the IP recorded in the audit log. Set this to
# your load balancer's address in production, and only then.
TRUSTED_PROXIES=
