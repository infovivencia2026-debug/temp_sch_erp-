# School ERP runtime configuration.
#
# The R2_* values below are placeholders. The web service will refuse to start
# until they are real — that is deliberate, so a half-configured deploy fails
# at boot rather than at the first file upload.

APP_ENV=production
HTTP_ADDR=127.0.0.1:8090
BASE_URL=https://erp.187-127-178-100.sslip.io

POSTGRES_DB=school_erp
POSTGRES_USER=erp_owner
POSTGRES_PASSWORD=REDACTED
APP_DB_USER=app_user
APP_DB_PASSWORD=REDACTED

DATABASE_URL=REDACTED
# 1 vCPU box shared with nginx and Postgres; a large pool would just queue.
DB_MAX_CONNS=10

# REDIS_URL used to live here; the queue is in Postgres (River) and the binaries
# ignore the variable.

SESSION_SECRET=REDACTED
SESSION_TTL=12h
SESSION_IDLE_TTL=2h
# Changing PASSWORD_PEPPER invalidates every password in the database.
PASSWORD_PEPPER=REDACTED
CREDENTIAL_KEY=REDACTED

# --- FILL THESE IN -------------------------------------------------------
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REDACTED
R2_SECRET_ACCESS_KEY=REDACTED
# -------------------------------------------------------------------------
R2_BUCKET=school-erp
R2_PUBLIC_HOST=
R2_PRESIGN_EXPIRY=10m

# Where `make publish-apk` puts the staff Android builds, and where /apps reads
# them from. On disk rather than in the binary: an APK is tens of megabytes and
# ships on its own schedule, so a driver-app fix must not require redeploying
# the server. The directory may be empty — /apps then says nothing is published
# rather than failing.
APK_DIR=/var/lib/temperp/apk
