{{define "login.gohtml"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in · School ERP</title>
<link rel="stylesheet" href="/static/app.css?v={{.AssetVersion}}">
<script>
  /* The appearance chosen on the pricing page carries here. Without it a
     visitor who picked dark, clicked Sign in, and was handed a white card
     would reasonably conclude the setting had not taken. */
  try {
    var t = localStorage.getItem('theme');
    if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
</script>
</head>
<body class="auth">
  <main class="card">
    <h1>Sign in</h1>
    <p class="lede">School ERP</p>
    {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="next" value="{{.Next}}">
      <label for="identifier">Username, email or phone</label>
      <input id="identifier" type="text" name="identifier" required autocomplete="username" autofocus>
      <label for="password">Password</label>
      <input id="password" type="password" name="password" required autocomplete="current-password">
      <button type="submit">Sign in</button>
    </form>
  </main>
</body>
</html>{{end}}
