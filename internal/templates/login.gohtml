{{define "login.gohtml"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in · WISEN</title>
<link rel="stylesheet" href="/static/app.css?v={{.AssetVersion}}">
{{template "themeboot"}}
</head>
<body class="auth">
  <div class="auth-top">{{template "themebtn"}}</div>
  <div class="auth-split">
    <!-- The brand panel: what the product is, beside where you sign in to it.
         Its animated colour field is pure CSS and decorative (aria-hidden), and
         it freezes under prefers-reduced-motion; the deep base colour means it
         still reads correctly on an engine that renders the blur weakly. It is
         hidden entirely on a narrow phone so the form leads. -->
    <aside class="auth-brand">
      <div class="mesh" aria-hidden="true">
        <span class="blob blob-1"></span>
        <span class="blob blob-2"></span>
        <span class="blob blob-3"></span>
        <span class="blob blob-4"></span>
        <span class="blob blob-5"></span>
      </div>
      <div class="auth-brand-content">
        <div class="auth-brand-mark" aria-hidden="true">✳</div>
        <div class="auth-brand-text">
          {{/* Minimal, on the owner's instruction: three lines, one idea --
               everything a school runs, in one place. The longer paragraph
               this replaced listed the modules; the list is what the product
               is for, not what the door needs to say. */}}
          <p class="auth-brand-eyebrow">One login</p>
          <h2 class="auth-brand-title">One stop for the whole school.</h2>
          <p class="auth-brand-sub">Admissions, fees, attendance, exams &mdash; office, staff room and parents.</p>
        </div>
      </div>
    </aside>
    <main class="card">
      {{if .LogoURL}}<img class="brand-logo" src="{{.LogoURL}}" alt="">{{end}}
      <h1>{{if .Headline}}{{.Headline}}{{else}}Sign in{{end}}</h1>
      <p class="lede">{{if .SchoolName}}{{.SchoolName}}{{else}}WISEN{{end}}</p>
      {{if .Message}}<p class="brand-message">{{.Message}}</p>{{end}}
      {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
      {{if .MFAStep}}
      <form method="post" action="/login/mfa" autocomplete="off">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="next" value="{{.Next}}">
        <label for="code">Six-digit code from your authenticator app</label>
        <input id="code" type="text" name="code" inputmode="numeric" pattern="[0-9 ]*" maxlength="7" required autocomplete="one-time-code" autofocus>
        <button type="submit">Continue</button>
      </form>
      <p class="fineprint"><a href="/login">Start again</a> &middot; Lost the phone? Ask the school office to switch two-factor off for you.</p>
      {{else}}
      <form method="post" action="/login" autocomplete="on">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="next" value="{{.Next}}">
        <label for="identifier">Username, email or phone</label>
        <input id="identifier" type="text" name="identifier" required autocomplete="username" autofocus>
        <label for="password">Password</label>
        <input id="password" type="password" name="password" required autocomplete="current-password">
        <button type="submit">Sign in</button>
      </form>
      <p class="fineprint"><a href="/forgot">Forgotten your password?</a> · <a href="/privacy">Privacy</a></p>
      {{end}}
    </main>
  </div>
{{template "themejs"}}
{{template "pwreveal"}}
</body>
</html>{{end}}
