{{define "login.gohtml"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in · School ERP</title>
<link rel="stylesheet" href="/static/app.css?v={{.AssetVersion}}">
{{template "themeboot"}}
</head>
<body class="auth">
  <div class="auth-top">{{template "themebtn"}}</div>
  <main class="card">
    <h1>Sign in</h1>
    <p class="lede">School ERP</p>
    {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="next" value="{{.Next}}">
      <label for="identifier">Username, email or phone</label>
      <input id="identifier" type="text" name="identifier" required autocomplete="username" autofocus>
      <label for="password">Password</label>
      <input id="password" type="password" name="password" required autocomplete="current-password">
      <button type="submit">Sign in</button>
    </form>
    <p class="fineprint"><a href="/forgot">Forgotten your password?</a></p>
  </main>
{{template "themejs"}}
{{template "pwreveal"}}
</body>
</html>{{end}}
