{{define "buy.gohtml"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>School ERP — pricing</title>
<meta name="description" content="A complete school ERP for Indian K-12 schools: admissions, attendance, fees, examinations, payroll and the UDISE+ return. Monthly or yearly, unlimited users.">
<link rel="stylesheet" href="/static/app.css?v={{.AssetVersion}}">
{{template "themeboot"}}
<script>
  /* Before the first paint, deliberately: a theme restored afterwards is a
     white flash on every load for anybody who chose dark. Wrapped because
     storage throws in a locked-down browser, and a themed page is not worth
     failing to render over. */
  try {
    var t = localStorage.getItem('theme');
    if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
</script>
</head>
<body class="marketing pricing">

<header class="topbar">
  <span class="wordmark">School ERP</span>
  <span class="spacer"></span>
  {{template "themebtn"}}
  <a class="quiet" href="/login">Sign in</a>
</header>

<main>
  <section class="price-hero">
    <h1>Select your School ERP plan</h1>
    <p class="lede">Start today. Your school is set up the moment the payment clears.</p>

    <!-- The toggle is a real control with a real fallback: without JavaScript
         the yearly prices are the ones rendered, which are the ones most
         schools buy and the ones the system has always billed. -->
    <div class="billing" id="billing">
      <span class="bill-label" data-for="monthly">Monthly</span>
      <button type="button" id="billing-toggle" class="switch" role="switch"
              aria-checked="true" aria-label="Show monthly prices">
        <span class="knob"></span>
      </button>
      <span class="bill-label on" data-for="yearly">
        Yearly
        <span class="save-tag" id="save-tag">save up to 33%</span>
      </span>
    </div>
  </section>

  <section class="tiers" aria-label="Plans">
    {{range $i, $p := .Plans}}
    <article class="tier tier-{{$p.Code}}{{if $p.Featured}} featured{{end}}">
      {{if $p.Featured}}<span class="ribbon">Most schools choose this</span>{{end}}

      <div class="tier-head">
        <h2>{{$p.Name}}</h2>
        <p class="amount">
          <span class="rupee">₹</span><span class="figure"
            data-yearly="{{$p.Rupees}}"
            data-monthly="{{if $p.Monthly}}{{$p.Monthly}}{{else}}{{$p.Rupees}}{{end}}">{{$p.Rupees}}</span>
          <span class="per" data-yearly="per year" data-monthly="{{if $p.Monthly}}per month{{else}}per year{{end}}">per year</span>
        </p>
        <p class="cap">{{$p.MaxStudents}}</p>
        {{if and $p.Monthly $p.SavingPct}}
          <p class="tier-save" data-saving="{{$p.SavingPct}}">Paying yearly saves {{$p.SavingPct}}%</p>
        {{else if not $p.Monthly}}
          <p class="tier-save">Sold by the year</p>
        {{end}}
        <a class="tier-cta" href="/signup?plan={{$p.Code}}" data-plan="{{$p.Code}}">Get started</a>
      </div>

      <div class="tier-body">
        {{if $p.Featured}}<p class="tier-eyebrow">Everything in Starter, plus</p>{{end}}
        <ul>
          {{range $p.Modules}}<li>{{.}}</li>{{end}}
        </ul>
      </div>
    </article>
    {{end}}
  </section>

  <section class="included">
    <h2>In every plan</h2>
    <ul>
      <li>Unlimited staff, student and parent accounts</li>
      <li>Role-based access, so a teacher sees their classes and nobody else's</li>
      <li>Daily backups, and your data stays in India</li>
      <li>UDISE+ and APAAR fields on every student record</li>
      <li>An audit trail of every change, which is what an inspection asks for</li>
      <li>Setup and staff training included in the first year</li>
    </ul>
  </section>

  <section class="enquire" id="enquire">
    <h2>Would rather talk to somebody first?</h2>
    <p class="lede">
      Leave your details and we will telephone you. No account is created and
      nothing is charged.
    </p>

    {{if .Sent}}
      <p class="sent">Thank you — we have your enquiry. Somebody will call you about {{.School}}.</p>
    {{else}}
      {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
      <form method="post" action="/buy">
        <div class="grid">
          <div class="row">
            <label for="school_name">School name<span aria-hidden="true">*</span></label>
            <input id="school_name" name="school_name" value="{{.School}}" required>
          </div>
          <div class="row">
            <label for="contact_name">Your name<span aria-hidden="true">*</span></label>
            <input id="contact_name" name="contact_name" value="{{.Contact}}" required>
          </div>
          <div class="row">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="{{.Email}}">
          </div>
          <div class="row">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" value="{{.Phone}}">
          </div>
          <div class="row">
            <label for="district">District</label>
            <input id="district" name="district" value="{{.District}}">
          </div>
          <div class="row">
            <label for="students">How many students?</label>
            <input id="students" name="students" inputmode="numeric" value="{{.Students}}">
          </div>
        </div>
        <div class="row">
          <label for="plan_code">Plan you are considering</label>
          <select id="plan_code" name="plan_code">
            <option value="">Not sure yet</option>
            {{range .Plans}}<option value="{{.Code}}" {{if eq $.Plan .Code}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        <div class="row">
          <label for="message">Anything you want us to know</label>
          <textarea id="message" name="message" rows="3">{{.Message}}</textarea>
        </div>
        <button type="submit">Ask us to call</button>
      </form>
    {{end}}
  </section>
</main>

<footer class="foot">
  <a href="/login">Sign in</a> · <a href="#enquire">Talk to us</a>
</footer>

<script>
/* The billing toggle.
 *
 * Prices are rendered by the server and swapped from data attributes here,
 * rather than fetched: the page must show a real price on first paint, and a
 * figure that arrives after a round trip is a figure somebody screenshots
 * mid-flight. Yearly is the default because it is what the system bills and
 * what most schools buy.
 */
(function () {
  var toggle = document.getElementById('billing-toggle');
  if (!toggle) return;
  var wrap = document.getElementById('billing');
  var tag = document.getElementById('save-tag');
  var yearly = true;

  function apply() {
    document.querySelectorAll('.figure, .per').forEach(function (el) {
      var v = el.getAttribute(yearly ? 'data-yearly' : 'data-monthly');
      if (v) el.textContent = v;
    });
    document.querySelectorAll('.tier-save[data-saving]').forEach(function (el) {
      el.textContent = yearly
        ? 'Paying yearly saves ' + el.getAttribute('data-saving') + '%'
        : 'Save ' + el.getAttribute('data-saving') + '% by paying yearly';
    });
    // The link carries the choice through to checkout, so the order records
    // what the school actually agreed to rather than the default.
    document.querySelectorAll('.tier-cta').forEach(function (a) {
      a.setAttribute('href', '/signup?plan=' + a.getAttribute('data-plan') +
        '&billing=' + (yearly ? 'yearly' : 'monthly'));
    });
    wrap.querySelectorAll('.bill-label').forEach(function (l) {
      l.classList.toggle('on', l.getAttribute('data-for') === (yearly ? 'yearly' : 'monthly'));
    });
    toggle.setAttribute('aria-checked', String(yearly));
    toggle.classList.toggle('off', !yearly);
    if (tag) tag.hidden = !yearly;
  }

  toggle.addEventListener('click', function () { yearly = !yearly; apply(); });
  apply();
})();


/* The light under the pointer.
 *
 * Two custom properties per card, written on pointermove and read by a
 * radial-gradient in the stylesheet. Nothing is measured in the handler beyond
 * the card's own box, and the properties drive a paint rather than a layout,
 * so this stays cheap on a phone.
 *
 * Skipped entirely where the pointer is coarse or motion is unwelcome: a
 * highlight that follows a finger is a highlight permanently stuck under the
 * last tap.
 */
(function () {
  var fine = true, ok = true;
  try {
    fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    ok = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  } catch (e) {}
  if (!fine || !ok) return;

  document.querySelectorAll('.tier').forEach(function (card) {
    card.addEventListener('pointermove', function (e) {
      var b = card.getBoundingClientRect();
      card.style.setProperty('--mx', (e.clientX - b.left) + 'px');
      card.style.setProperty('--my', (e.clientY - b.top) + 'px');
    });
    card.addEventListener('pointerleave', function () {
      card.style.removeProperty('--mx');
      card.style.removeProperty('--my');
    });
  });
})();
</script>

{{template "themejs"}}
</body>
</html>{{end}}
