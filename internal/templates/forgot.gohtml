{{define "forgot.gohtml"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reset your password · School ERP</title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/static/app.css?v={{.AssetVersion}}">
{{template "themeboot"}}
</head>
<body class="auth">
  <div class="auth-top">{{template "themebtn"}}</div>
  <main class="card">
    <h1>Reset your password</h1>
    <p class="lede">We will send you a link. Choose where it should go.</p>

    {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}

    {{if .Notice}}
      <p class="sent">{{.Notice}}</p>
      {{if .Sent}}
        <p class="fineprint">Sent to {{.Sent}}.</p>
      {{end}}
      {{if .Link}}
        <p class="fineprint">
          This school has no {{if eq .Channel "whatsapp"}}WhatsApp{{else}}email{{end}}
          provider set up, so nothing was actually delivered. Rather than
          pretend otherwise, here is the link:
        </p>
        <p><a class="cta" href="{{.Link}}">Choose a new password</a></p>
      {{end}}
      <p class="fineprint"><a href="/login">Back to sign in</a></p>
    {{else}}
      <form method="post" action="/forgot" autocomplete="on">
        <div class="row">
          <label for="identifier">Email, username or phone</label>
          <input id="identifier" name="identifier" autocomplete="username" required autofocus>
        </div>
        <div class="row">
          <label for="channel">Send the link by</label>
          <select id="channel" name="channel">
            <option value="email">Email</option>
            <option value="whatsapp">WhatsApp</option>
          </select>
        </div>
        <button type="submit">Send me a link</button>
      </form>
      <p class="fineprint">
        Remembered it? <a href="/login">Sign in</a>. Whichever you pick, it goes
        to the address or number your school already holds for you — if it has
        neither, ask the office to issue a password instead.
      </p>
    {{end}}
  </main>
{{template "themejs"}}
</body>
</html>{{end}}
