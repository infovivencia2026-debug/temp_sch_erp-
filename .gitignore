/dist/
/web/dist/
/web/node_modules/
.env
*.log

# Compiled binaries. `make dist` cross-compiles these for the server; 59MB of
# build output does not belong in source, and a stale binary in a checkout is
# worse than no binary at all.
/bin/

# A previously deployed copy of the SPA bundle. web/dist is the real build
# output and is already ignored; this is the same thing under another name.
/spa/

# Claude Code personal overrides (names the production host; do not commit)
.claude/settings.local.json

# Agent worktrees are scratch space, not source.
.claude/

# node_modules is an install artefact, never a tracked symlink.
web/node_modules/
scripts/__pycache__/

# Cloud Run configuration and secrets for deploy/cloudrun/*.sh: the Neon and
# Upstash URLs, the pepper copied from the VPS, the R2 keys. Secret Manager is
# where these live once uploaded; this file is the one local copy.
deploy/cloudrun/.env.cloudrun
